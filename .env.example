# Development only. Copy to .env locally; provide actual secrets during deployment.
APP_ENV=development
# Generate a local URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=crm
POSTGRES_DB=crm
API_PORT=8000
# Direct uv/alembic commands: set URLs for your own development services.
# Compose supplies internal service URLs automatically.
DATABASE_URL=postgresql+asyncpg://crm@127.0.0.1:5432/crm
REDIS_URL=redis://127.0.0.1:6379/0

# Optional on the dev server. Native webhooks and MAX login are disabled without tokens.
MAX_STAFF_TOKEN=
MAX_OBSERVER_TOKEN=
# Different URL-safe secrets, 32-256 characters; register them with MAX subscriptions.
MAX_STAFF_WEBHOOK_SECRET=
MAX_OBSERVER_WEBHOOK_SECRET=
# Printed by: python -m app.bot.setup init --name ... --house ...
MAX_BOT_ORGANIZATION_ID=
# Comma-separated MAX user IDs; no automatic admission of arbitrary MAX users.
MAX_OWNER_IDS=
MAX_OPERATOR_IDS=
MAX_EMPLOYEE_IDS=
MAX_INIT_DATA_TTL_SECONDS=300
MAX_INIT_DATA_FUTURE_SKEW_SECONDS=30
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
MAX_TIMEOUT_SECONDS=10

# DeepSeek V4 Flash is the primary group-chat classifier.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=8
DEEPSEEK_MIN_CONFIDENCE=0.72

# Disposable Compose test services, bound to localhost.
TEST_POSTGRES_PORT=15432
TEST_REDIS_PORT=16379
# Export TEST_DATABASE_URL / TEST_REDIS_URL only for disposable test services.
